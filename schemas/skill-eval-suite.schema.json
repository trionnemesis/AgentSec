{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentsec.dev/schemas/skill-eval-suite.schema.json",
  "title": "AgentSec static Skill Assurance suite",
  "description": "A reviewed, deterministic Phase 0 Skill Assurance suite. It pins one discovered skill and every file in that skill bundle by full SHA-256. It carries no prompt, runner, command, model, credential, endpoint or verdict.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "suite_id",
    "profile",
    "skill_id",
    "entrypoint",
    "references",
    "scripts"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "agentsec.dev/v1alpha1" },
    "kind": { "const": "SkillEvalSuite" },
    "suite_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "profile": { "const": "static" },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,119}$"
    },
    "entrypoint": { "$ref": "#/$defs/pin" },
    "references": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pin" }
    },
    "scripts": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pin" }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "required": ["path", "digest"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!~)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[%\\\\])[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
