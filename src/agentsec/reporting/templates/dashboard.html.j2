<!DOCTYPE html>
<html lang="en" data-theme="auto">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AgentSec — {{ d.project.project_id or 'unnamed project' }}</title>
<style>
{% include "_theme.css.j2" %}

  /* --- dashboard-specific -------------------------------------------------- */
  .masthead { display: flex; flex-wrap: wrap; gap: .75rem 1.5rem; align-items: baseline;
              justify-content: space-between; margin-bottom: .25rem; }
  .planes { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            margin: 1.25rem 0; }
  .plane { background: var(--card); border: 1px solid var(--line); border-radius: 10px;
           padding: 1rem 1.15rem; }
  .plane h3 { margin: 0 0 .35rem; font-size: .95rem; }
  .plane .why { color: var(--muted); font-size: .82rem; margin: .5rem 0 0; }
  .kv { display: grid; grid-template-columns: auto 1fr; gap: .25rem .75rem; font-size: .875rem; }
  .kv dt { color: var(--muted); }
  .kv dd { margin: 0; }
  .finding { border-left: 3px solid var(--warn); padding: .4rem 0 .4rem .75rem; margin: .6rem 0; }
  .finding[hidden] { display: none; }
  select.chip { appearance: none; padding-inline-end: 1.4rem; }
</style>
</head>
<body>
<div class="wrap">

  <div class="masthead">
    <div>
      <h1>{{ d.project.name or 'AgentSec' }}</h1>
      <div class="sub" style="margin-bottom:0">
        {% if d.project.status == 'declared' %}
          project <code>{{ d.project.project_id }}</code>
        {% else %}
          <span class="pill skip">project {{ d.project.status.replace('_', ' ') }}</span>
        {% endif %}
        {% if d.project.fingerprint %}
          {# The first thing on the page, because every count below it means
             something different depending on the answer. A classification, not
             a conclusion: nothing has been executed to produce it. #}
          · AI agent
          <span class="pill {{ 'warn' if d.project.fingerprint.agent_presence in ('confirmed', 'likely') else 'skip' }}">{{ d.project.fingerprint.agent_presence.replace('_', ' ') }}</span>
          {% for agent in d.project.fingerprint.runtime_agents %}
            <code>{{ agent.framework }}</code>{{ '' if loop.last else ',' }}
          {% endfor %}
        {% endif %}
        · target <code>{{ d.purple.target_id }}</code>
        · profile <code>{{ d.purple.profile }}</code>
      </div>
    </div>
    <div class="sub" style="margin-bottom:0">
      last refresh <time datetime="{{ d.generated_at }}">{{ d.generated_at }}</time><br>
      schema <code>{{ d.schema_version }}</code>
    </div>
  </div>

  {% if d.project.status != 'declared' %}
    <div class="banner" style="color:var(--warn);background:var(--warn-bg)">
      This dashboard does not know which repository it is describing.
      {{ d.project.detail }}
    </div>
  {% endif %}

  {% if d.purple.blocking_count %}
    <div class="banner bad">
      {{ d.purple.blocking_count }} blocking finding{{ '' if d.purple.blocking_count == 1 else 's' }} —
      CI exit code {{ d.purple.exit_code }}
    </div>
  {% else %}
    <div class="banner ok">No blocking findings — CI exit code {{ d.purple.exit_code }}</div>
  {% endif %}

  {% if d.purple.fixture_derived %}
    <div class="banner info">
      Every verdict in view was proven against a replayed fixture corpus, not a live
      run — a <code>secure</code> here means the recording shows no evidence of the
      attack succeeding, not that a live staging agent was attacked.
    </div>
  {% endif %}

  {# Planes side by side and never added together. A Skill outcome is not a
     PurpleVerdict and does not belong in a verdict count; see ADR 0008. A repo
     risk is not one either — it is a reason to run a scenario, not a result. #}
  <div class="planes">
    {% if d.project.fingerprint %}
      {# Runtime agents and coding-agent configuration are rendered as two
         separate rows and never summed. A single "agent surfaces" number would
         let a .mcp.json read as a runtime agent, which is the one overclaim
         this classification exists to prevent (#32). #}
      <div class="plane">
        <h3>
          AI agent
          <span class="pill {{ 'warn' if d.project.fingerprint.agent_presence in ('confirmed', 'likely') else 'skip' }}">{{ d.project.fingerprint.agent_presence.replace('_', ' ') }}</span>
        </h3>
        <dl class="kv">
          <dt>confidence</dt><dd>{{ d.project.fingerprint.confidence }}</dd>
          {% for agent in d.project.fingerprint.runtime_agents %}
            <dt>{{ agent.framework }}</dt>
            <dd>
              {{ agent.language }}{% if agent.entrypoints %} ·
                {% for path in agent.entrypoints %}<code>{{ path }}</code>{{ '' if loop.last else ' ' }}{% endfor %}
              {% else %} · no entrypoint found{% endif %}
            </dd>
          {% endfor %}
          {% if d.project.fingerprint.development_agent_config %}
            <dt>coding-agent config</dt>
            <dd>{{ d.project.fingerprint.development_agent_config | map(attribute='platform') | join(', ') }}</dd>
          {% endif %}
          {% if d.project.fingerprint.problems %}
            <dt>unparsed</dt><dd>{{ d.project.fingerprint.problems | length }} file(s)</dd>
          {% endif %}
        </dl>
        <p class="why">
          {% if d.project.fingerprint.agent_presence == 'configuration_only' %}
            A coding agent works on this repository; the repository does not implement one.
          {% elif d.project.fingerprint.agent_presence == 'not_detected' %}
            No agent framework, tool calling or agent configuration was found. That is an
            absence of evidence, not a pass — nothing was executed to establish it.
          {% elif d.project.fingerprint.agent_presence == 'unsupported' %}
            Something here could not be classified. Stated rather than rounded down to
            "no agent found".
          {% else %}
            Read statically from dependencies, imports and builder calls. No repository
            code was imported or run.
          {% endif %}
        </p>
      </div>
    {% endif %}
    <div class="plane">
      <h3>
        Repository risk
        <span class="pill {{ 'skip' if d.repo_risk.status != 'inspected' else ('fail' if d.repo_risk.counts.by_severity.get('critical', 0) or d.repo_risk.counts.by_severity.get('high', 0) else 'warn') }}">{{ d.repo_risk.status }}</span>
      </h3>
      <dl class="kv">
        {% if d.repo_risk.status == 'inspected' %}
          <dt>risks</dt><dd>{{ d.repo_risk.counts.total }}</dd>
          <dt>critical + high</dt>
          <dd>{{ d.repo_risk.counts.by_severity.get('critical', 0) + d.repo_risk.counts.by_severity.get('high', 0) }}</dd>
          <dt>verified</dt><dd>{{ d.repo_risk.counts.by_verification.get('verified', 0) }}</dd>
          <dt>runnable</dt><dd>{{ d.repo_risk.counts.by_verification.get('verifiable', 0) }}</dd>
          <dt>unprovable</dt><dd>{{ d.repo_risk.counts.by_verification.get('not_verifiable', 0) }}</dd>
        {% else %}
          <dt>reason</dt><dd><code>{{ d.repo_risk.reason }}</code></dd>
        {% endif %}
      </dl>
      <p class="why">
        What this repository's own agent configuration exposes. Static rules over
        files — nothing here has been executed, so no row is a verdict.
      </p>
    </div>
    <div class="plane">
      <h3>Purple — attack &amp; detection</h3>
      <dl class="kv">
        <dt>scenarios</dt><dd>{{ d.purple.total_runs }}</dd>
        <dt>secure</dt><dd>{{ d.purple.secure }}</dd>
        <dt>gaps</dt><dd>{{ d.purple.total_runs - d.purple.secure }}</dd>
        <dt>blocking</dt><dd>{{ d.purple.blocking_count }}</dd>
      </dl>
      <p class="why">Did the attack work, and would the blue side have seen it?</p>
    </div>
    <div class="plane">
      <h3>
        Skill Assurance
        <span class="pill {{ status_class(d.skill_assurance.status) }}">{{ d.skill_assurance.status }}</span>
      </h3>
      <dl class="kv">
        <dt>reason</dt><dd><code>{{ d.skill_assurance.reason }}</code></dd>
        {% if d.skill_assurance.counts %}
          <dt>skills found</dt><dd>{{ d.skill_assurance.counts.get('supported_skills', 0) }}</dd>
        {% endif %}
      </dl>
      <p class="why">{{ d.skill_assurance.detail }}</p>
    </div>
    {% if d.project.surfaces %}
      <div class="plane">
        <h3>Surfaces</h3>
        <dl class="kv">
          {% for key, n in d.project.surfaces.items() if key != 'supported_skills' %}
            <dt>{{ key.replace('_', ' ') }}</dt><dd>{{ n }}</dd>
          {% endfor %}
        </dl>
        <p class="why">What the harness can see in this repository, not what it has judged.</p>
      </div>
    {% endif %}
    <div class="plane">
      <h3>
        Static posture
        <span class="pill {{ status_class(d.static_posture.status) }}">{{ d.static_posture.status }}</span>
      </h3>
      <dl class="kv">
        {% if d.static_posture.status == 'ingested' %}
          <dt>source</dt>
          <dd><code>{{ d.static_posture.source_tool }}{% if d.static_posture.source_version %} {{ d.static_posture.source_version }}{% endif %}</code></dd>
          {% for state in ['covered', 'not_tested', 'n/a'] %}
            <dt>{{ state.replace('_', ' ') }}</dt><dd>{{ d.static_posture.counts.get(state, 0) }}</dd>
          {% endfor %}
        {% else %}
          <dt>reason</dt><dd><code>{{ d.static_posture.reason }}</code></dd>
        {% endif %}
      </dl>
      <p class="why">
        A scanner's grade is never a verdict here — it names a surface; only a scenario
        with a verdict can say whether an attack through it would be seen.
      </p>
    </div>
  </div>

  {% if d.purple.superseded_runs %}
    <p class="sub">
      Counts show each scenario's latest run. {{ d.purple.superseded_runs }} earlier
      run{{ '' if d.purple.superseded_runs == 1 else 's' }} are kept out of the totals and
      shown as trend below.
    </p>
  {% endif %}

  <h2>The four axes</h2>
  <p class="sub">
    An attack that got through is one problem; an attack nobody saw is a different one.
    An axis a scenario never asserted stays <code>not_tested</code> — it never rounds up
    to a pass, here or anywhere else.
  </p>
  {% set axis_questions = {
    'prevention': 'Did the agent refuse to do the bad thing?',
    'detection': 'If it did — or tried — did the blue side see it, in time?',
    'evidence': 'Could an investigator reconstruct the incident afterwards?',
    'response': 'Did the documented or automated reaction actually happen?'
  } %}
  {% set glyphs = {'pass': '●', 'fail': '▲', 'error': '■', 'not_tested': '○'} %}
  <div class="meters">
    {% for axis in ['prevention', 'detection', 'evidence', 'response'] %}
      {% set counts = d.purple.axis_counts[axis] %}
      {% set total = counts.values() | sum %}
      <div class="meter">
        <div class="meter-label">
          <span class="name">{{ axis | capitalize }}</span>
          <span class="q">{{ axis_questions[axis] }}</span>
        </div>
        {% if total %}
          <div class="track" role="img" aria-label="{{ axis }}:
            {%- for status in ['pass', 'fail', 'error', 'not_tested'] %}
              {{- ' ' }}{{ counts[status] }} {{ status }}{{ ',' if not loop.last }}
            {%- endfor %}">
            {% for status in ['pass', 'fail', 'error', 'not_tested'] %}
              {% if counts[status] %}
                <div class="seg {{ status_class(status) }}" style="flex:{{ counts[status] }}"
                     title="{{ counts[status] }} scenario(s): {{ status }}">
                  <span class="glyph" aria-hidden="true">{{ glyphs[status] }}</span>
                  {{ counts[status] }} {{ status.replace('_', ' ') }}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% else %}
          <div class="empty">no runs</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <h2>Scenarios</h2>

  <div class="filters" id="filters">
    <span class="lbl">Verdict</span>
    <button type="button" class="chip" data-verdict="all" aria-pressed="true">all {{ d.purple.total_runs }}</button>
    <button type="button" class="chip" data-verdict="gap" aria-pressed="false">gaps {{ d.purple.total_runs - d.purple.secure }}</button>
    <button type="button" class="chip" data-verdict="secure" aria-pressed="false">secure {{ d.purple.secure }}</button>
    <button type="button" class="chip" data-verdict="blocking" aria-pressed="false">blocking {{ d.purple.blocking_count }}</button>

    {% set severities = d.purple.runs | map(attribute='severity') | unique | list %}
    {% if severities | length > 1 %}
      <span class="lbl" style="margin-left:.75rem">Severity</span>
      <button type="button" class="chip" data-severity="all" aria-pressed="true">any</button>
      {% for sev in ['critical', 'high', 'medium', 'low', 'info'] if sev in severities %}
        <button type="button" class="chip" data-severity="{{ sev }}" aria-pressed="false">{{ sev }}</button>
      {% endfor %}
    {% endif %}

    {# "Tested" is a filter and not a footnote: a reader looking for what nobody
       checked should be able to ask for exactly that. #}
    <span class="lbl" style="margin-left:.75rem">Tested</span>
    <button type="button" class="chip" data-tested="all" aria-pressed="true">any</button>
    <button type="button" class="chip" data-tested="partial" aria-pressed="false">has not_tested</button>
    <button type="button" class="chip" data-tested="errored" aria-pressed="false">has error</button>

    {% if d.purple.runs %}
      <span class="lbl" style="margin-left:.75rem">Scenario</span>
      <select class="chip" id="scenario-filter" aria-label="Filter by scenario">
        <option value="all">all scenarios</option>
        {% for r in d.purple.runs %}
          <option value="{{ r.scenario_id }}">{{ r.scenario_id }}</option>
        {% endfor %}
      </select>
    {% endif %}
  </div>

  <div class="scroll">
    <table>
      <thead>
        <tr>
          <th>Scenario</th><th>Prevention</th><th>Detection</th><th>Evidence</th>
          <th>Response</th><th>Verdict</th>{% if d.purple.history %}<th>Trend</th>{% endif %}
        </tr>
      </thead>
      <tbody>
      {% for r in d.purple.runs %}
        {% set axes = [r.prevention, r.detection, r.evidence, r.response] %}
        <tr class="run-row" data-verdict="{{ r.purple_verdict }}" data-severity="{{ r.severity }}"
            data-scenario="{{ r.scenario_id }}"
            data-blocking="{{ 'true' if r.blocking else 'false' }}"
            data-untested="{{ 'true' if 'not_tested' in axes else 'false' }}"
            data-errored="{{ 'true' if 'error' in axes else 'false' }}">
          <td><code>{{ r.scenario_id }}</code><br><span class="sub">{{ r.scenario_title }}</span></td>
          {% for axis in ['prevention', 'detection', 'evidence', 'response'] %}
            <td class="axis"><span class="pill {{ status_class(r[axis]) }}">{{ r[axis] }}</span></td>
          {% endfor %}
          <td>
            <span class="pill {{ verdict_class(r.purple_verdict) }}">{{ r.purple_verdict }}</span>
            {% if r.blocking %}<br><span class="pill fail">blocking</span>{% endif %}
          </td>
          {% if d.purple.history %}
            {% set past = d.purple.history.get(r.scenario_id, []) %}
            <td>
              {% if past | length > 1 %}
                <span class="spark" role="img"
                      aria-label="{{ past | length }} runs, oldest to newest:
                      {%- for h in past %}{{ ' ' }}{{ h.verdict }}{{ ',' if not loop.last }}{% endfor %}">
                  {% for h in past %}
                    <span class="tick {{ verdict_class(h.verdict) }}{{ ' now' if loop.last }}"
                          title="{{ h.run_id }} · {{ h.profile }} · {{ h.verdict }}"></span>
                  {% endfor %}
                </span>
                {% if past[-1].verdict != past[-2].verdict %}
                  <br><span class="sub">was {{ past[-2].verdict }}</span>
                {% endif %}
              {% else %}
                <span class="sub">first run</span>
              {% endif %}
            </td>
          {% endif %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="empty" id="no-match" hidden>No scenario matches this filter.</p>

  <h2>What failed</h2>
  {% if not d.purple.runs %}
    <p class="empty">No runs are stored for this project yet.</p>
  {% endif %}
  {% for r in d.purple.runs if r.purple_verdict != 'secure' or r.collector_errors %}
    <details class="run-detail" data-verdict="{{ r.purple_verdict }}" data-severity="{{ r.severity }}"
             data-scenario="{{ r.scenario_id }}"
             data-blocking="{{ 'true' if r.blocking else 'false' }}"
             data-untested="{{ 'true' if 'not_tested' in [r.prevention, r.detection, r.evidence, r.response] else 'false' }}"
             data-errored="{{ 'true' if 'error' in [r.prevention, r.detection, r.evidence, r.response] else 'false' }}"
             open>
      <summary>
        <span class="pill {{ verdict_class(r.purple_verdict) }}">{{ r.purple_verdict }}</span>
        <code>{{ r.scenario_id }}</code> — {{ r.scenario_title }}
      </summary>
      <p class="sub">
        run <code>{{ r.run_id }}</code> · severity {{ r.severity }} · gate {{ r.gate }}
        {% if r.owasp %} · OWASP {{ r.owasp | join(', ') }}{% endif %}
      </p>
      <p>{{ r.rationale }}</p>

      {% if r.collector_errors %}
        <p><strong>Evidence could not be collected:</strong></p>
        {% for e in r.collector_errors %}
          <div class="check"><div class="a">{{ e.source }}</div><div class="o">{{ e.message }}</div></div>
        {% endfor %}
      {% endif %}

      {# Evaluator-authored fields only. `assertion`, `observed` and `reason` are
         written by the evaluator from the committed contract; the transcript that
         produced them is not in this document and must not be rendered from one. #}
      {% for c in r.failed_checks %}
        <div class="check">
          <div class="a">[{{ c.axis }}] {{ c.assertion }}</div>
          <div class="o">observed: {{ c.observed }}</div>
          {% if c.reason %}<div class="r">why it matters: {{ c.reason }}</div>{% endif %}
        </div>
      {% endfor %}
    </details>
  {% endfor %}

  {% if d.repo_risk.risks %}
    <h2>Repository attack surface</h2>
    <p class="sub">
      This repository's own agent configuration — skills, agents, hooks, tool grants,
      MCP servers and memory stores — read by static rules. A risk is a reason to run a
      scenario, never the result of having run one. The verification column is the
      difference: <code>verified</code> means a scenario covering that surface produced a
      verdict, <code>runnable</code> means one exists and has not, and
      <code>unprovable</code> means nothing in the catalogue exercises it — neither
      passing nor failing.
      {% if d.repo_risk.problems %}
        {{ d.repo_risk.problems | length }} surface(s) could not be read and are listed
        as problems rather than counted as clean.
      {% endif %}
    </p>

    {% if d.repo_risk.verify_queue %}
      <p class="sub">
        <strong>{{ d.repo_risk.verify_queue | length }} scenario(s) would settle a high or
        critical risk here and have not run:</strong>
        <code>{{ d.repo_risk.verify_queue | join(', ') }}</code> —
        <code>agentsec scan --verify --target &lt;id&gt;</code>
      </p>
    {% endif %}

    <div class="filters" id="risk-filters">
      <span class="lbl">Verification</span>
      <button type="button" class="chip" data-verification="all" aria-pressed="true">all {{ d.repo_risk.counts.total }}</button>
      <button type="button" class="chip" data-verification="verifiable" aria-pressed="false">runnable {{ d.repo_risk.counts.by_verification.get('verifiable', 0) }}</button>
      <button type="button" class="chip" data-verification="verified" aria-pressed="false">verified {{ d.repo_risk.counts.by_verification.get('verified', 0) }}</button>
      <button type="button" class="chip" data-verification="not_verifiable" aria-pressed="false">unprovable {{ d.repo_risk.counts.by_verification.get('not_verifiable', 0) }}</button>
    </div>

    <div class="scroll">
      <table>
        <thead>
          <tr><th>Rule</th><th>Severity</th><th>Surface</th><th>File</th><th>Verification</th></tr>
        </thead>
        <tbody>
        {% for r in d.repo_risk.risks %}
          <tr class="risk-row" data-verification="{{ r.verification.state }}">
            <td><code>{{ r.rule_id }}</code><br><span class="sub">{{ r.title }}</span></td>
            <td>
              <span class="pill {{ 'fail' if r.severity in ('critical', 'high') else ('warn' if r.severity == 'medium' else 'skip') }}">
                {{ r.severity }}
              </span>
            </td>
            <td>{{ r.surface_kind.replace('_', ' ') }}</td>
            <td><code>{{ r.file }}</code></td>
            <td>
              <span class="pill {{ 'pass' if r.verification.state == 'verified' else ('warn' if r.verification.state == 'verifiable' else 'skip') }}">
                {{ 'runnable' if r.verification.state == 'verifiable' else ('unprovable' if r.verification.state == 'not_verifiable' else r.verification.state) }}
              </span>
              {% if r.verification.scenario_ids %}<br><span class="sub">{{ r.verification.scenario_ids | join(', ') }}</span>{% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="empty" id="risk-no-match" hidden>No risk matches this filter.</p>
  {% endif %}

  {% if d.static_posture.findings %}
    <h2>Static posture findings</h2>
    <p class="sub">
      Ingested from <code>{{ d.static_posture.source_tool }}</code>{% if d.static_posture.source_version %} {{ d.static_posture.source_version }}{% endif %}.
      <code>not_tested</code> is the default: a surface a scanner flagged with no
      scenario exercising it has been scanned, not tested.
      {% if d.static_posture.problems %}
        {{ d.static_posture.problems | length }} finding(s) named a file outside the
        project root and were refused rather than correlated.
      {% endif %}
    </p>

    <div class="filters" id="posture-filters">
      <span class="lbl">Coverage</span>
      <button type="button" class="chip" data-coverage="all" aria-pressed="true">all {{ d.static_posture.findings | length }}</button>
      <button type="button" class="chip" data-coverage="not_tested" aria-pressed="false">flagged but untested {{ d.static_posture.counts.get('not_tested', 0) }}</button>
      <button type="button" class="chip" data-coverage="covered" aria-pressed="false">covered {{ d.static_posture.counts.get('covered', 0) }}</button>
      <button type="button" class="chip" data-coverage="n/a" aria-pressed="false">n/a {{ d.static_posture.counts.get('n/a', 0) }}</button>
    </div>

    <div class="scroll">
      <table>
        <thead>
          <tr><th>Rule</th><th>Severity</th><th>Category</th><th>File</th><th>Coverage</th></tr>
        </thead>
        <tbody>
        {% for f in d.static_posture.findings %}
          <tr class="posture-row" data-coverage="{{ f.coverage }}">
            <td><code>{{ f.rule_id }}</code><br><span class="sub">{{ f.title }}</span></td>
            <td>
              <span class="pill {{ 'fail' if f.severity in ('critical', 'high') else ('warn' if f.severity == 'medium' else 'skip') }}">
                {{ f.severity }}
              </span>
            </td>
            <td>{{ f.category }}</td>
            <td><code>{{ f.file }}</code></td>
            <td>
              <span class="pill {{ 'pass' if f.coverage == 'covered' else 'skip' }}">{{ f.coverage }}</span>
              {% if f.scenario_ids %}<br><span class="sub">{{ f.scenario_ids | join(', ') }}</span>{% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="empty" id="posture-no-match" hidden>No finding matches this filter.</p>
  {% endif %}

  {% if findings %}
    <h2>Open findings</h2>
    <p class="sub">
      A finding cannot reach <code>verified</code> without a linked regression test,
      and a detection gap additionally needs a linked detection rule.
    </p>
    {% for f in findings %}
      <div class="finding">
        <div class="a">
          <span class="pill {{ 'fail' if f.status in ('new', 'reproduced') else 'warn' }}">{{ f.status }}</span>
          <code>{{ f.finding_id }}</code> — {{ f.title }}
        </div>
        <div class="o">
          {{ f.severity }} · scenario <code>{{ f.scenario_id }}</code> · target
          <code>{{ f.target_id }}</code> · {{ f.verdict }}
        </div>
      </div>
    {% endfor %}
  {% endif %}

  <footer>
    Verdicts are produced by the deterministic AgentSec evaluator from the scenario
    contract and collected evidence. No language model participates in the pass/fail
    decision.<br>
    This page reads <code>agentsec://dashboard/latest</code>{% if findings %} and
    <code>agentsec://findings</code>{% endif %} on a report gateway. Opening,
    filtering and refreshing it start no run, write no file and change no finding —
    the gateway it binds to has no tool that could.
    {% if d.redaction %}
      Published under policy <code>{{ d.redaction.policy }}</code>.
    {% endif %}
  </footer>
</div>

<script>
(function () {
  "use strict";
  var bar = document.getElementById("filters");
  if (!bar) { return; }
  var state = { verdict: "all", severity: "all", tested: "all", scenario: "all" };
  var items = document.querySelectorAll(".run-row, .run-detail");
  var note = document.getElementById("no-match");

  function matches(el) {
    var data = el.dataset;
    if (state.severity !== "all" && data.severity !== state.severity) { return false; }
    if (state.scenario !== "all" && data.scenario !== state.scenario) { return false; }
    if (state.tested === "partial" && data.untested !== "true") { return false; }
    if (state.tested === "errored" && data.errored !== "true") { return false; }
    if (state.verdict === "blocking") { return data.blocking === "true"; }
    if (state.verdict === "secure") { return data.verdict === "secure"; }
    if (state.verdict === "gap") { return data.verdict !== "secure"; }
    return true;
  }

  function apply() {
    var visibleRows = 0;
    items.forEach(function (el) {
      var ok = matches(el);
      el.hidden = !ok;
      if (ok && el.classList.contains("run-row")) { visibleRows++; }
    });
    if (note) { note.hidden = visibleRows !== 0; }
  }

  bar.querySelectorAll(".chip").forEach(function (chip) {
    if (chip.tagName === "SELECT") { return; }
    var group = ["verdict", "severity", "tested"].filter(function (g) {
      return chip.dataset[g] !== undefined;
    })[0];
    if (!group) { return; }
    chip.addEventListener("click", function () {
      bar.querySelectorAll(".chip").forEach(function (other) {
        if (other.dataset[group] !== undefined) { other.setAttribute("aria-pressed", "false"); }
      });
      chip.setAttribute("aria-pressed", "true");
      state[group] = chip.dataset[group];
      apply();
    });
  });

  var picker = document.getElementById("scenario-filter");
  if (picker) {
    picker.addEventListener("change", function () {
      state.scenario = picker.value;
      apply();
    });
  }
}());

(function () {
  "use strict";
  var bar = document.getElementById("posture-filters");
  if (!bar) { return; }
  var rows = document.querySelectorAll(".posture-row");
  var note = document.getElementById("posture-no-match");
  var coverage = "all";

  function apply() {
    var visible = 0;
    rows.forEach(function (el) {
      var ok = coverage === "all" || el.dataset.coverage === coverage;
      el.hidden = !ok;
      if (ok) { visible++; }
    });
    if (note) { note.hidden = visible !== 0; }
  }

  bar.querySelectorAll(".chip").forEach(function (chip) {
    chip.addEventListener("click", function () {
      bar.querySelectorAll(".chip").forEach(function (other) {
        other.setAttribute("aria-pressed", "false");
      });
      chip.setAttribute("aria-pressed", "true");
      coverage = chip.dataset.coverage;
      apply();
    });
  });
}());

(function () {
  "use strict";
  var bar = document.getElementById("risk-filters");
  if (!bar) { return; }
  var rows = document.querySelectorAll(".risk-row");
  var note = document.getElementById("risk-no-match");
  var state = "all";

  function apply() {
    var visible = 0;
    rows.forEach(function (el) {
      var ok = state === "all" || el.dataset.verification === state;
      el.hidden = !ok;
      if (ok) { visible++; }
    });
    if (note) { note.hidden = visible !== 0; }
  }

  bar.querySelectorAll(".chip").forEach(function (chip) {
    chip.addEventListener("click", function () {
      bar.querySelectorAll(".chip").forEach(function (other) {
        other.setAttribute("aria-pressed", "false");
      });
      chip.setAttribute("aria-pressed", "true");
      state = chip.dataset.verification;
      apply();
    });
  });
}());
</script>
</body>
</html>
